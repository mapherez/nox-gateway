# Reference only. The executable does not automatically load .env files.
# Default HTTP listener serves diagnostics/declaration only; no Suite admission.
NOX_GATEWAY_LISTEN_ADDR=127.0.0.1:8080
NOX_GATEWAY_DATA_DIR=./data
NOX_GATEWAY_LOG_LEVEL=info
NOX_GATEWAY_SHUTDOWN_TIMEOUT_MS=10000

# Suite transport/trust: HTTPS origins without application prefixes.
# NOX_GATEWAY_PUBLIC_URL=https://gateway.home.arpa
# NOX_GATEWAY_BACKEND_URL=https://backend.home.arpa
# Approve only the actual installation network and required destination ports.
# NOX_GATEWAY_SUITE_ALLOWED_CIDRS=192.168.10.0/24
# NOX_GATEWAY_SUITE_ALLOWED_PORTS=443
# NOX_GATEWAY_TLS_CA_FILE=/absolute/path/to/homelab-root.crt

# Direct TLS: configure both. Key must be owner-private (0600/0400).
# NOX_GATEWAY_TLS_CERT_FILE=/absolute/path/to/gateway-cert.pem
# NOX_GATEWAY_TLS_KEY_FILE=/absolute/path/to/gateway-key.pem

# Or TLS termination in NPM: exact trusted peer(s), and that public leaf cert.
# NOX_GATEWAY_TRUSTED_PROXY_CIDRS=172.19.0.2/32
# NOX_GATEWAY_PUBLIC_TLS_CERT_FILE=/absolute/path/to/npm-cert.pem

# Optional explicit SPKI trust instead of normal PKI for Backend.
# NOX_GATEWAY_BACKEND_TLS_PIN=<administrator-approved-base64url-SPKI-SHA256>

# One-time intent exported by the Backend admin. Private file, never a CLI secret.
# NOX_GATEWAY_PAIRING_FILE=/absolute/path/to/pairing.json
