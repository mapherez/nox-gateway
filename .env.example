# Reference only for bare Go execution; the binary does not load .env files.
NOX_GATEWAY_LISTEN_ADDR=127.0.0.1:8080
NOX_GATEWAY_DATA_DIR=./data
NOX_GATEWAY_LOG_LEVEL=info
NOX_GATEWAY_SHUTDOWN_TIMEOUT_MS=10000
NOX_GATEWAY_CALL_TIMEOUT_MS=20000
NOX_GATEWAY_PROBE_INTERVAL_MS=15000
NOX_GATEWAY_MAX_CONCURRENT=32
NOX_GATEWAY_MAX_PAYLOAD_BYTES=2097152
# Enable the local channel explicitly outside Docker. Images/Compose do this.
# NOX_GATEWAY_SUITE_SOCKET_DIR=/run/nox-suite
# Optional native HTTP/HTTPS URL (not the logical service origin).
# NOX_GATEWAY_PUBLIC_URL=http://gateway.home.arpa
# Optional native direct TLS; no certificate is required for Suite pairing.
# NOX_GATEWAY_TLS_CERT_FILE=/path/to/cert.pem
# NOX_GATEWAY_TLS_KEY_FILE=/path/to/key.pem
# Compose settings: host port and existing volume names.
# NOX_GATEWAY_PORT=5711
# NOX_GATEWAY_DATA_VOLUME_NAME=nox-gateway-data
# NOX_SUITE_LOCAL_VOLUME_NAME=nox-suite-local
